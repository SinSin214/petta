model Pet {
  id            String           @id @default(uuid())
  name          String
  age           Int
  typeId        String
  ageTypeId     String
  sizeTypeId    String

  location    PetLocation?      @relation("PetLocation")
  personalities String[]
  description   String
  imageUrl      String[]
  isAdopted     Boolean           @default(false)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt()
  createdBy     String
  createdByUser User              @relation("PetCreatedBy", fields: [createdBy], references: [id])
  updatedBy     String
  updatedByUser User              @relation("PetUpdatedBy", fields: [updatedBy], references: [id])

  @@index([typeId, ageTypeId, sizeTypeId])
}

model PetLocation {
  id   String @id @default(uuid())
  
  pet Pet? @relation("PetLocation", fields: [petId], references: [id])
  petId String @unique

  address String
  districtId String
  provinceId String
}